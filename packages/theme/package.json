{
	"name": "@morgan-vieira-npm/sensation-theme",
	"version": "0.0.0",
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"import": "./src/index.ts"
		},
		"./effects.css": {
			"default": "./src/effects.css"
		}
	},
	"publishConfig": {
		"types": "./dist/index.d.ts",
		"exports": {
			".": {
				"types": "./dist/index.d.ts",
				"import": "./dist/index.js"
			},
			"./effects.css": {
				"default": "./dist/effects.css"
			}
		}
	},
	"scripts": {
		"build": "tsc --project tsconfig.build.json && node scripts/copy-styles.mjs",
		"check": "tsc --project tsconfig.json",
		"test": "vitest run"
	},
	"devDependencies": {
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
